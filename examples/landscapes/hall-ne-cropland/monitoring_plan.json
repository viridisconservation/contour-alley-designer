  "schedule": [
    {
      "indicator": "baseline soil sampling (SOC 0-30 cm, bulk density, texture)",
      "strata": "all",
      "when": "year 0 before planting"
    },
    {
      "indicator": "establishment_survival",
      "strata": "row",
      "when": "every fall, years 1-3; then years 5, 10"
    },
    {
      "indicator": "tree_height_m",
      "strata": "row",
      "when": "every fall, years 1-5; then every 5 years"
    },
    {
      "indicator": "soil moisture (0-30 cm sensors)",
      "strata": "row, 0-1H, 3-6H, >6H x upper/lower",
      "when": "monthly in the growing season, from year 1"
    },
    {
      "indicator": "alley_crop_yield_t_ha",
      "strata": "all alley strata",
      "when": "every harvest (yield monitor or hand plots by distance from row)"
    },
    {
      "indicator": "tree_crop_yield_t_per_row_ha",
      "strata": "row",
      "when": "every harvest from first bearing"
    },
    {
      "indicator": "soc_tC_ha",
      "strata": "all",
      "when": "years 5, 10, 20, 40 (same points as baseline)"
    },
    {
      "indicator": "field_outflow_mm_yr",
      "strata": "outlet",
      "when": "event runoff at the outlet if a flume is installed; otherwise skip"
    },
    {
      "indicator": "snow depth and density transects",
      "strata": "transects across rows: 0-1H, 1-3H, 3-6H, >6H",
      "when": "late February each year"
    }
  ]
}
